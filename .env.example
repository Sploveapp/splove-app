# Supabase (obligatoire pour `npm run build` — notamment Capacitor iOS)
# Copier ce fichier vers `.env` à la racine avant build / cap sync.
# Dashboard → Authentication → URL Configuration :
# - Site URL : URL de prod (PAS localhost pour tests iPhone)
# - Redirect URLs (obligatoire Capacitor) :
#   splove://auth/callback
#   splove://login-callback  (legacy, optionnel)
# - Dev web : http://localhost:5173, URL Render, etc.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_ENV=local
VITE_VERIFF_PUBLIC_KEY=

# Edge Function `send-push-notification` — secrets Supabase (pas VITE_) :
# PUSH_WEBHOOK_SECRET, APNS_KEY_ID, APNS_TEAM_ID, APNS_PRIVATE_KEY, APNS_BUNDLE_ID=com.splove.app
# APNS_PRODUCTION=false|true, FCM_SERVICE_ACCOUNT_JSON
# SQL : UPDATE public.push_webhook_settings SET functions_base_url, webhook_secret (migration 113)

# Edge Function `moderate-photo` — secrets dans le dashboard Supabase (pas VITE_) :
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (injectés par la plateforme)
# SIGHTENGINE_API_USER=…
# SIGHTENGINE_API_SECRET=…
# Sans Sightengine : les photos passent en pending_review (sauf MODERATION_STUB_APPROVED=1 côté Edge, réservé au dev)

# Bêta : Splove+ / paywalls non bloquants + message discret sur la page SPLove+
# VITE_BETA_MODE=true

# SPLove Play — monétisation (architecture uniquement, aucun paiement branché)
# VITE_ENABLE_SPLOVE_PLUS=true   # Play inclus dans SPLove+ actif
# VITE_ENABLE_PLAY_PACK=true     # Pack Play (entitlement play_pack)
